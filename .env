# Comma-separated list of allowed frontend origins — no trailing slash.
# CORS rejects '*' when credentials (cookies) are involved, so every origin
# that calls this API must be listed exactly.
#
# Cross-domain note: SameSite=None requires Secure (HTTPS). While this server
# is HTTP-only, the frontend must be served from the SAME HOST (93.127.142.143)
# so that cookies are treated as same-site and SameSite=Lax works.
# Once HTTPS is added, switch to: REFRESH_COOKIE_SAMESITE=none and REFRESH_COOKIE_SECURE=true
FRONTEND_URLS=http://localhost:3000,http://93.127.142.143,http://93.127.142.143:3000,http://93.127.142.143:4173
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
